# ---- Core --------------------------------------------------------------
APP_ENV=development                 # set to "production" to enforce a strong API_KEY and hide /docs
LOG_LEVEL=INFO

# Shared secret the dashboard sends as X-API-Key. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# ---- Database ----------------------------------------------------------
# Used by the Postgres container (docker-compose) AND to build DATABASE_URL below.
POSTGRES_USER=bearingpulse
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=pricedb
# Docker: host is "postgres". Local without Docker: use localhost, or sqlite:///./dev.db
DATABASE_URL=postgresql://bearingpulse:replace-with-a-strong-password@postgres:5432/pricedb

# ---- Queue -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Scraping ----------------------------------------------------------
SCRAPEOPS_API_KEY=
PROXY_LIST=
SCRAPE_INTERVAL_MINUTES=30
MAX_CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=2

# ---- Alerts ------------------------------------------------------------
ALERT_THRESHOLD_PCT=5
ALERT_EMAIL=notify@example.com
ALERT_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Web ---------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Optional services -------------------------------------------------
# Streamlit (legacy dashboard) -> API
DASHBOARD_API_BASE=http://app:8000/api
# Flower (Celery monitor) basic auth, "user:password"
FLOWER_BASIC_AUTH=admin:replace-with-a-password
